-- Q16. Identify products that contribute the most to overall revenue (top 10 by revenue share).

select * from zepto;

WITH revenue_cte AS (
    SELECT 
        name,
        category,
        (discountedSellingPrice * availableQuantity) AS product_revenue
    FROM zepto
),
total_cte AS (
    SELECT SUM(product_revenue) AS total_revenue
    FROM revenue_cte
)
SELECT 
    r.name,
    r.category,
    r.product_revenue,
    ROUND((r.product_revenue / t.total_revenue) * 100, 2) AS revenue_share_percent
FROM revenue_cte r, total_cte t
ORDER BY r.product_revenue DESC
LIMIT 10;


-- Q17. Find the percentage of out-of-stock products in each category.

WITH stock_stats AS (
    SELECT 
        category,
        COUNT(*) AS total_products,
        SUM(CASE WHEN outofstock = TRUE THEN 1 ELSE 0 END) AS out_of_stock_products
    FROM zepto
    GROUP BY category
)
SELECT 
    category,
    total_products,
    out_of_stock_products,
    ROUND((out_of_stock_products::numeric / total_products) * 100, 2) AS out_of_stock_percent
FROM stock_stats
ORDER BY out_of_stock_percent DESC; 
--::numeric → converts the value to a numeric type so division works correctly and gives decimals (not integers).

-- Q18. List categories where the average selling price per gram exceeds ₹2.

WITH price_per_gram AS (
    SELECT 
        category,
        AVG(discountedSellingPrice / weightInGms) AS avg_price_per_gram
    FROM zepto
    WHERE weightInGms > 0
    GROUP BY category
)
SELECT 
    category,
    ROUND(avg_price_per_gram, 2) AS avg_price_per_gram
FROM price_per_gram
WHERE avg_price_per_gram > 2
ORDER BY avg_price_per_gram DESC;



